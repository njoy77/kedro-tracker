// Build settings for the Kedro app target.
//
// Supabase credentials live in Secrets.xcconfig, which is gitignored and generated from
// Vercel by `bun run env:pull` (see Secrets.example.xcconfig for its keys).

#include? "Secrets.xcconfig"
#include "API.xcconfig"

// The app group shared with KedroWidgets and KedroClip (entitlements and Info.plist
// `KedroAppGroup`; Shared/AppGroup.swift reads it).
KEDRO_APP_GROUP = group.com.njoy77.kedro
