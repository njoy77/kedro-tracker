# The API's environment. Don't fill this in by hand: `bun run env:pull` writes apps/api/.env.local
# from Vercel, and Bun loads it. See apps/api/src/config.ts.
PORT=8787
# From kedro-tracker (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The rest live in the kedro-api project, production only. Secrets never come back from Vercel,
# so a local pull leaves them empty and the API runs on memory.
#   bun run env:push SUPABASE_SERVICE_ROLE_KEY --project api --sensitive   (value on stdin)
#   bun scripts/api-keys.ts                                               (KEDRO_CLIP_SECRET, KEDRO_LINK_SIGNING_KEY)
#   bun run env:push KEDRO_PUBLIC_URL=https://api.playkedro.com --project api
SUPABASE_SERVICE_ROLE_KEY=
# Optional: verifies legacy HS256 access tokens locally (otherwise the API asks Supabase Auth).
SUPABASE_JWT_SECRET=
KEDRO_CLIP_SECRET=
KEDRO_LINK_SIGNING_KEY=
KEDRO_PUBLIC_URL=
# Local only, without Supabase: in-memory store and "dev:<uuid>" bearer tokens.
# KEDRO_DEV_AUTH=1
