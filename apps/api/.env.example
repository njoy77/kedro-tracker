# The API's environment. Don't fill this in by hand: `bun run env:pull` writes apps/api/.env.local
# from Vercel (project kedro-tracker), and Bun loads it. See apps/api/src/config.ts.
PORT=8787
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Add it to Vercel with: bun run env:push SUPABASE_SERVICE_ROLE_KEY --environment preview,production --sensitive
SUPABASE_SERVICE_ROLE_KEY=
# Optional: verifies legacy HS256 access tokens locally (otherwise the API asks Supabase Auth).
SUPABASE_JWT_SECRET=
# Local only, without Supabase: in-memory store and "dev:<uuid>" bearer tokens.
# KEDRO_DEV_AUTH=1
