{
  "name": "kedro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@kedro/web' --filter '@kedro/api' dev",
    "dev:web": "bun run --filter '@kedro/web' dev",
    "dev:api": "bun run --filter '@kedro/api' dev",
    "build": "bun run --filter '@kedro/web' build",
    "typecheck": "bun run --filter '*' typecheck",
    "ios:open": "bun run --filter '@kedro/ios' open",
    "ios:build": "bun run --filter '@kedro/ios' build",
    "env:pull": "bun scripts/env.ts pull",
    "env:push": "bun scripts/env.ts push"
  },
  "devDependencies": {
    "vercel": "65.4.0"
  }
}
